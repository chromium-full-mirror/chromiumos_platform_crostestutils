<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:ignore="HardcodedText">

    <TableLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <TableRow
            android:id="@+id/table_header" >

            <TextView
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:layout_weight="0.5"
                android:padding="5dp"
                android:gravity="center_vertical"
                android:textAlignment="center"
                tools:ignore="RtlCompat" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:layout_weight="0.5"
                android:padding="5dp"
                android:text="Status"
                android:gravity="center_vertical"
                android:textAlignment="center"
                tools:ignore="RtlCompat" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:layout_weight="0.5"
                android:padding="5dp"
                android:text="Control"
                android:gravity="center_vertical"
                android:textAlignment="center"
                tools:ignore="RtlCompat" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:padding="5dp"
                android:text="Operation"
                android:gravity="center_vertical"
                android:textAlignment="center"
                tools:ignore="RtlCompat" />

        </TableRow>

        <TableRow
            android:layout_height="2dp"
            android:background="?android:attr/listDivider" />

        <TableRow
            android:id="@+id/table_bt_availability" >

            <TextView
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:layout_weight="0.5"
                android:padding="5dp"
                android:text="Availability"
                android:gravity="center_vertical"
                android:textAlignment="center"
                tools:ignore="RtlCompat" />

            <TextView
                android:id="@+id/txt_bt_availability"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:layout_weight="0.5"
                android:padding="5dp"
                android:text="N/A"
                android:gravity="center_vertical"
                android:textAlignment="center"
                tools:ignore="RtlCompat" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:layout_weight="0.5"
                android:padding="5dp" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:padding="5dp"
                android:text=""
                android:gravity="center_vertical"
                android:textAlignment="center"
                tools:ignore="RtlCompat" />

        </TableRow>

        <TableRow
            android:layout_height="2dp"
            android:background="?android:attr/listDivider" />

        <TableRow
            android:id="@+id/table_bt_permission" >

            <TextView
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:layout_weight="0.5"
                android:padding="5dp"
                android:text="Permission"
                android:gravity="center_vertical"
                android:textAlignment="center"
                tools:ignore="RtlCompat" />

            <TextView
                android:id="@+id/txt_bt_permission"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:layout_weight="0.5"
                android:padding="5dp"
                android:text="N/A"
                android:gravity="center_vertical"
                android:textAlignment="center"
                tools:ignore="RtlCompat" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:layout_weight="0.5"
                android:padding="5dp"
                android:orientation="vertical">

                <Button
                    android:id="@+id/btn_request_bt"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:padding="5dp"
                    android:text="Request" />

            </LinearLayout>

            <TextView
                android:id="@+id/txt_bt_permission_op_stat"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:padding="5dp"
                android:layout_weight="1"
                android:text="N/A"
                android:gravity="center_vertical"
                android:textAlignment="center"
                tools:ignore="RtlCompat" />

        </TableRow>

        <TableRow
            android:layout_height="2dp"
            android:background="?android:attr/listDivider" />

        <TableRow
            android:id="@+id/table_bt_activation" >

            <TextView
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:layout_weight="0.5"
                android:padding="5dp"
                android:text="On/Off"
                android:gravity="center_vertical"
                android:textAlignment="center"
                tools:ignore="RtlCompat" />

            <TextView
                android:id="@+id/txt_bt_activation"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:layout_weight="0.5"
                android:padding="5dp"
                android:text="N/A"
                android:gravity="center_vertical"
                android:textAlignment="center"
                tools:ignore="RtlCompat" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:layout_weight="0.5"
                android:padding="5dp"
                android:orientation="vertical">

                <Button
                    android:id="@+id/btn_turn_on_bt"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:layout_weight="0.5"
                    android:text="Turn On" />

                <Button
                    android:id="@+id/btn_turn_off_bt"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:layout_weight="0.5"
                    android:text="Turn Off" />

            </LinearLayout>

            <TextView
                android:id="@+id/txt_bt_activation_op_stat"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:padding="5dp"
                android:layout_weight="1"
                android:text="N/A"
                android:gravity="center_vertical"
                android:textAlignment="center"
                tools:ignore="RtlCompat" />

        </TableRow>

        <TableRow
            android:layout_height="2dp"
            android:background="?android:attr/listDivider" />

    </TableLayout>

</androidx.constraintlayout.widget.ConstraintLayout>