SCRIPT_ROOT=$(dirname "$(readlink -f "$0")")
SCRIPT=${SCRIPT_ROOT}/performance/bootperf-bin/$(basename "$0")

if [ ! -f "${SCRIPT}" ]; then
  echo "${SCRIPT} not found."
  echo "This script must be run inside the chroot. Aborting"
  exit 1
fi

exec "${SCRIPT}" "$@"
